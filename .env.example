# AWS Configuration
AWS_REGION=us-east-1

# S3 buckets (created by serverless deploy — names include stage suffix)
RECEIPTS_BUCKET=kk-payments-receipts-staging
PROCESSED_BUCKET=kk-payments-processed-staging
NOTIFIER_BUCKET=kk-notifier-output-staging

# Application
STAGE=staging
SERVICE_NAME=kijani-kiosk

# Database (kk-payments Kubernetes service — not used by Lambdas)
DB_HOST=your-db-host-here
DB_NAME=kijanikiosk
DB_USER=your-db-user-here
