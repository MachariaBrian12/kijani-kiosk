# DOCUMENTATION ONLY — AWS credentials for S3 receipt uploads from kk-payments.
# On EKS prefer IRSA instead of long-lived keys.
#
# kubectl create secret generic kk-payments-aws \
#   --from-literal=AWS_ACCESS_KEY_ID='<key>' \
#   --from-literal=AWS_SECRET_ACCESS_KEY='<secret>' \
#   -n kijani-staging
#
# IAM policy (minimum): s3:PutObject on arn:aws:s3:::kk-payments-receipts-staging/*
# Production bucket: kk-payments-receipts-production
